-- Таблица: заглавная русская → строчная
local upperToLower = {
	["А"]="а", ["Б"]="б", ["В"]="в", ["Г"]="г",
	["Д"]="д", ["Е"]="е", ["Ё"]="ё", ["Ж"]="ж",
	["З"]="з", ["И"]="и", ["Й"]="й", ["К"]="к",
	["Л"]="л", ["М"]="м", ["Н"]="н", ["О"]="о",
	["П"]="п", ["Р"]="р", ["С"]="с", ["Т"]="т",
	["У"]="у", ["Ф"]="ф", ["Х"]="х", ["Ц"]="ц",
	["Ч"]="ч", ["Ш"]="ш", ["Щ"]="щ", ["Ъ"]="ъ",
	["Ы"]="ы", ["Ь"]="ь", ["Э"]="э", ["Ю"]="ю",
	["Я"]="я"
}

-- Таблица: строчная русская → заглавная
local lowerToUpper = {
	["а"]="А", ["б"]="Б", ["в"]="В", ["г"]="Г",
	["д"]="Д", ["е"]="Е", ["ё"]="Ё", ["ж"]="Ж",
	["з"]="З", ["и"]="И", ["й"]="Й", ["к"]="К",
	["л"]="Л", ["м"]="М", ["н"]="Н", ["о"]="О",
	["п"]="П", ["р"]="Р", ["с"]="С", ["т"]="Т",
	["у"]="У", ["ф"]="Ф", ["х"]="Х", ["ц"]="Ц",
	["ч"]="Ч", ["ш"]="Ш", ["щ"]="Щ", ["ъ"]="Ъ",
	["ы"]="Ы", ["ь"]="Ь", ["э"]="Э", ["ю"]="Ю",
	["я"]="Я"
}

-- Получить первую букву строки в нижнем регистре (надёжно для кириллицы)
local function getFirstLetter(text)
	text = text:gsub("^%s+", ""):gsub("%s+$", "")
	if text == "" then
		return nil
	end
	local ch = string.sub(text, 1, 1)
	-- заглавная русская → строчная
	if upperToLower[ch] then
		return upperToLower[ch]
	end
	-- уже строчная русская
	if lowerToUpper[ch] then
		return ch
	end
	-- что-то другое (латиница, цифра, символ)
	return nil
end

-- Очистить список слов
local function clearList()
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
end

-- Убрать дубликаты, сохранив порядок
local function dedupe(arr)
	local seen = {}
	local result = {}
	for _, v in ipairs(arr) do
		if not seen[v] then
			seen[v] = true
			table.insert(result, v)
		end
	end
	return result
end

-- Основная функция поиска
local function findWords()
	local firstLetter = getFirstLetter(input.Text)

	if not firstLetter then
		clearList()
		status.Text = "Введи русскую букву от А до Я"
		return
	end

	local words = dictionary[firstLetter]

	clearList()

	if not words or #words == 0 then
		status.Text = "Для буквы «" .. lowerToUpper[firstLetter] .. "» слов пока нет"
		return
	end

	words = dedupe(words)

	status.Text = "Найдено: " .. #words
		.. "  •  Буква: " .. lowerToUpper[firstLetter]

	for i, word in ipairs(words) do
		local item = Instance.new("TextLabel")
		item.Name = "Word_" .. i
		item.Size = UDim2.new(1, -4, 0, 34)
		item.BackgroundColor3 = BG
		item.BackgroundTransparency = 0.15
		item.BorderSizePixel = 0
		item.Text = "   " .. lowerToUpper[firstLetter]
			.. "   •   " .. tostring(word)
		item.TextColor3 = WHITE
		item.TextSize = 14
		item.Font = Enum.Font.GothamMedium
		item.TextXAlignment = Enum.TextXAlignment.Left
		item.LayoutOrder = i
		item.Parent = list

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = item
	end

	list.CanvasPosition = Vector2.zero
end

-- Привязки: кнопка и Enter
search.Activated:Connect(findWords)

input.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		findWords()
	end
end)

-- Дополнительно: Enter работает даже вне фокуса поля
UserInputService.InputBegan:Connect(function(inputObject, processed)
	if processed then return end
	if inputObject.KeyCode == Enum.KeyCode.Return
		or inputObject.KeyCode == Enum.KeyCode.KeypadEnter then
		findWords()
	end
end)
