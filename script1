-- Словарь



local function clearList()
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
end

local function findWords()
	local text = string.lower(input.Text)
	text = text:gsub("^%s+", ""):gsub("%s+$", "")

	local firstLetter = utf8.char(utf8.codepoint(text, 1, 1))

	if not firstLetter then
		status.Text = "Введи русскую букву!"
		return
	end

	if not dictionary[firstLetter] then
		status.Text = "Используй русскую букву от А до Я"
		return
	end

	clearList()

	local words = dictionary[firstLetter]
	status.Text = "Найдено: " .. #words .. "  •  Буква: " .. string.upper(firstLetter)

	for i, word in ipairs(words) do
		local item = Instance.new("TextLabel")
		item.Name = "Word_" .. i
		item.Size = UDim2.new(1, -4, 0, 34)
		item.BackgroundColor3 = BG
		item.BackgroundTransparency = 0.15
		item.BorderSizePixel = 0
		item.Text = "   " .. string.upper(firstLetter) .. "   •   " .. word
		item.TextColor3 = WHITE
		item.TextSize = 14
		item.Font = Enum.Font.GothamMedium
		item.TextXAlignment = Enum.TextXAlignment.Left
		item.LayoutOrder = i
		item.Parent = list

		Instance.new("UICorner", item).CornerRadius = UDim.new(0, 8)
	end

	list.CanvasPosition = Vector2.zero
end

search.Activated:Connect(findWords)

input.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		findWords()
	end
end)

