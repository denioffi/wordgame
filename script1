-- Таблица преобразования заглавных русских букв
local lowerToUpper = {
	["а"]="А", ["б"]="Б", ["в"]="В", ["г"]="Г",
	["д"]="Д", ["е"]="Е", ["ё"]="Ё", ["ж"]="Ж",
	["з"]="З", ["и"]="И", ["й"]="Й", ["к"]="К",
	["л"]="Л", ["м"]="М", ["н"]="Н", ["о"]="О",
	["п"]="П", ["р"]="Р", ["с"]="С", ["т"]="Т",
	["у"]="У", ["ф"]="Ф", ["х"]="Х", ["ц"]="Ц",
	["ч"]="Ч", ["ш"]="Ш", ["щ"]="Щ", ["ъ"]="Ъ",
	["ы"]="Ы", ["ь"]="Ь", ["э"]="Э", ["ю"]="Ю",
	["я"]="Я"
}

local function findWords()
	local firstLetter = getFirstLetter(input.Text)

	if not firstLetter then
		clearList()
		status.Text = "Сначала введи русскую букву!"
		return
	end

	-- Проверяем букву через таблицу, а не через match
	if not lowerToUpper[firstLetter] then
		clearList()
		status.Text = "Введи русскую букву от А до Я"
		return
	end

	local words = dictionary[firstLetter]

	clearList()

	if not words then
		status.Text = "Для этой буквы слов пока нет"
		return
	end

	status.Text = "Найдено: " .. #words
		.. "  •  Буква: " .. lowerToUpper[firstLetter]

	for i, word in ipairs(words) do
		local item = Instance.new("TextLabel")
		item.Name = "Word_" .. i
		item.Size = UDim2.new(1, -4, 0, 34)
		item.BackgroundColor3 = BG
		item.BackgroundTransparency = 0.15
		item.BorderSizePixel = 0
		item.Text = "   " .. lowerToUpper[firstLetter]
			.. "   •   " .. tostring(word)
		item.TextColor3 = WHITE
		item.TextSize = 14
		item.Font = Enum.Font.GothamMedium
		item.TextXAlignment = Enum.TextXAlignment.Left
		item.LayoutOrder = i
		item.Parent = list

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = item
	end

	list.CanvasPosition = Vector2.zero
end
