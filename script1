local isRunning = false
local usedWords = {} 
local currentLetter = "" 
local lastFingerprint = ""

-- Очистка визуального списка
local function clearList()
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("TextLabel") then child:Destroy() end
	end
end

local function addWordToList(word, letter)
	local item = Instance.new("TextLabel")
	item.Size = UDim2.new(1, -4, 0, 34)
	item.BackgroundColor3 = BG
	item.BackgroundTransparency = 0.15
	item.BorderSizePixel = 0
	item.Text = "   " .. letter .. "   •   " .. tostring(word)
	item.TextColor3 = WHITE
	item.TextSize = 14
	item.Font = Enum.Font.GothamMedium
	item.TextXAlignment = Enum.TextXAlignment.Left
	item.Parent = list
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = item
end

local function giveWord(letter)
	if letter == "" then return end

	local words = dictionary[letter]
	
	if not words or #words == 0 then
		status.Text = "Нет слов на «" .. letter .. "»"
		return
	end

	local availableWords = {}
	for _, word in ipairs(words) do
		if not usedWords[word] then
			table.insert(availableWords, word)
		end
	end

	if #availableWords == 0 then
		status.Text = "Слова на «" .. letter .. "» закончились!"
		return
	end

	local randomWord = availableWords[1]
	usedWords[randomWord] = true

	addWordToList(randomWord, letter)
	status.Text = "Слово на «" .. letter .. "» выдано"
end

local function getRoundFingerprint()
	local wordTiles = playerGui:FindFirstChild("WordTiles", true)
	if not wordTiles then return nil end
	local fingerprint = ""
	for _, tile in ipairs(wordTiles:GetChildren()) do
		if tile.Name:match("^Letter%d+$") then
			local glyph = tile:FindFirstChild("Glyph")
			if glyph and glyph:IsA("TextLabel") then
				fingerprint = fingerprint .. tile.Name .. ":" .. glyph.Text .. "|"
			end
		end
	end
	return fingerprint
end

local function getCurrentLetterFromScreen()
	local letter1 = playerGui:FindFirstChild("Letter1", true)
	if letter1 then
		local glyph = letter1:FindFirstChild("Glyph")
		if glyph and glyph:IsA("TextLabel") then
			return glyph.Text:gsub("%s+", "")
		end
	end
	return ""
end

local checkConnection = nil

local function startChecking()
	if isRunning then return end
	isRunning = true
	toggleBtn.Text = "⏹ СТОП"
	toggleBtn.BackgroundColor3 = RED
	status.Text = "Ожидание нового раунда..."
	lastFingerprint = ""
	
	-- СБРОС ПАМЯТИ И ЭКРАНА ПРИ СТАРТЕ
	usedWords = {} 
	clearList()

	checkConnection = RunService.Heartbeat:Connect(function()
		local fingerprint = getRoundFingerprint()
		if not fingerprint or fingerprint == "" then return end

		if fingerprint ~= lastFingerprint then
			lastFingerprint = fingerprint
			local newLetter = getCurrentLetterFromScreen()
			
			if newLetter ~= "" then
				currentLetter = newLetter
				currentLetterLabel.Text = "Буква: " .. newLetter
				
				giveWord(newLetter)
			end
		end
	end)
end

local function stopChecking()
	isRunning = false
	toggleBtn.Text = "▶ СТАРТ"
	toggleBtn.BackgroundColor3 = GREEN
	status.Text = "Остановлено"
	if checkConnection then
		checkConnection:Disconnect()
		checkConnection = nil
	end
end

toggleBtn.Activated:Connect(function()
	if isRunning then stopChecking() else startChecking() end
end)

-- Обработчик кнопки "ДРУГОЕ СЛОВО"
changeWordBtn.Activated:Connect(function()
	if currentLetter == "" then
		status.Text = "Сначала дождись буквы!"
		return
	end
	-- Выдаем новое слово на текущую букву
	giveWord(currentLetter)
end)
